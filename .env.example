# XDR-Lens Environment Variables
# Copy this file to .env.local and fill in your values.
# Note: All RPC URLs are pre-configured in lib/types.ts — no setup needed for basic use.

# ─── Optional: Custom RPC Endpoints ─────────────────────────────────────────
# Override the default Testnet Soroban RPC URL
NEXT_PUBLIC_TESTNET_RPC_URL=https://soroban-testnet.stellar.org

# Override the default Mainnet Soroban RPC URL
NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com

# Override the default Futurenet Soroban RPC URL
NEXT_PUBLIC_FUTURENET_RPC_URL=https://rpc-futurenet.stellar.org

# ─── Optional: Analytics ─────────────────────────────────────────────────────
# Uncomment to enable Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
